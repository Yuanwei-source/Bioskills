{
  "format": "mito-dependency-manifest-1",
  "comment": "依赖的唯一来源。env_check.py 读它做盘点与门禁；各脚本只声明自己属于哪个 stage（见 stages），不在脚本里重复写依赖列表——重复的清单就是下一个会漂移的缺陷（参见 #14 删除的双校验实现）。",
  "tiers": {
    "essential": "核心诊断能力所需：不全就应当先补齐，或明确报告哪些能力不可用",
    "extended": "增强能力（注释本体、专用结构预测、绘图等）：缺失不阻断基础诊断",
    "optional": "按需：联网查询、提交预检等一次性用途"
  },
  "python_libs": [
    {
      "id": "python3",
      "tier": "essential",
      "probe": {
        "type": "python-interpreter"
      },
      "min_version": "3.8",
      "purpose": "运行本 skill 的全部脚本",
      "install": "系统包管理器或 conda 安装 python>=3.8"
    },
    {
      "id": "jsonschema",
      "tier": "essential",
      "probe": {
        "type": "python-import",
        "module": "jsonschema",
        "distribution": "jsonschema"
      },
      "purpose": "版本3任务记录的唯一 schema 校验路径；缺失返回3，不创建案例",
      "install": "python3 -m pip install \"jsonschema>=4.18\""
    },
    {
      "id": "biopython",
      "tier": "essential",
      "probe": {
        "type": "python-import",
        "module": "Bio",
        "distribution": "biopython"
      },
      "purpose": "GenBank/FASTA 解析、密码表、序列统计（annot_check/blast_genes/circularize/mitos2_to_genbank/seq_stats）",
      "install": "python3 -m pip install biopython"
    }
  ],
  "tools": [
    {
      "id": "blastn",
      "tier": "essential",
      "probe": {
        "type": "command",
        "name": "blastn"
      },
      "purpose": "基因定位与同源检索（blast_genes / circularize）",
      "install": "conda install -c bioconda blast  或  apt-get install ncbi-blast+"
    },
    {
      "id": "makeblastdb",
      "tier": "essential",
      "probe": {
        "type": "command",
        "name": "makeblastdb"
      },
      "purpose": "建自比对库（circularize / 重复检查）",
      "install": "随 blastn 一同安装"
    },
    {
      "id": "samtools",
      "tier": "essential",
      "probe": {
        "type": "command",
        "name": "samtools"
      },
      "purpose": "BAM 排序/索引/深度与覆盖剖面（depth_analysis / circularize）",
      "install": "conda install -c bioconda samtools"
    },
    {
      "id": "minimap2",
      "tier": "essential",
      "probe": {
        "type": "command",
        "name": "minimap2",
        "env": "MINIMAP2"
      },
      "purpose": "reads 回贴（深度证据、接缝证据）",
      "install": "conda install -c bioconda minimap2"
    },
    {
      "id": "seqkit",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "seqkit"
      },
      "purpose": "FASTQ/FASTA 快速体检与子集抽取（辅助）",
      "install": "conda install -c bioconda seqkit"
    },
    {
      "id": "bwa",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "bwa"
      },
      "purpose": "备选比对器（仅在 minimap2 不适用时）",
      "install": "conda install -c bioconda bwa"
    },
    {
      "id": "mitos2",
      "tier": "extended",
      "probe": {
        "type": "python-module",
        "module": "mitos",
        "search_conda": true,
        "env": "MITOS2_PY",
        "distribution": "mitos"
      },
      "purpose": "线粒体注释（独立第二意见；本 skill 用 mitos2_to_genbank.py 转成 GenBank）",
      "install": "见 https://mitos2.bioinf.uni-leipzig.de/ （或 conda install -c bioconda mitos）"
    },
    {
      "id": "mitos2_refdir",
      "tier": "extended",
      "probe": {
        "type": "env-dir",
        "env": "MITOS2_REFDIR",
        "sub": "MITOS2_REFSEQVER"
      },
      "purpose": "MITOS2 参考数据库（数十 GB，通常镜像到本地/NAS）",
      "install": "设置 MITOS2_REFDIR 与 MITOS2_REFSEQVER（见 config/env.sh）"
    },
    {
      "id": "cmsearch",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "cmsearch",
        "env": "MITOS2_EXTRA_PATH"
      },
      "purpose": "MITOS2 的 rRNA 搜索（Infernal）",
      "install": "conda install -c bioconda infernal（并加入 MITOS2_EXTRA_PATH）"
    },
    {
      "id": "mitos2_reshape2",
      "tier": "extended",
      "probe": {
        "type": "r-package",
        "package": "reshape2",
        "env": "MITOS2_RSCRIPT",
        "search_conda": true
      },
      "purpose": "MITOS2 绘制 blast 统计图的 R 依赖；脚本即使不需要查看图也会调用它",
      "install": "使用已有 R 环境中带 reshape2 的 Rscript，并设置 MITOS2_RSCRIPT；本 skill 不自动安装或修改环境"
    },
    {
      "id": "tRNAscan-SE",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "tRNAscan-SE"
      },
      "purpose": "tRNA 结构预测（tRNA 缺失分级的独立证据）",
      "install": "conda install -c bioconda trnascan-se"
    },
    {
      "id": "mitofinder",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "mitofinder"
      },
      "purpose": "需要近缘参考 GenBank 的独立 reads 组装/注释路线，也可对现有组装注释",
      "install": "conda install -c bioconda mitofinder"
    },
    {
      "id": "plot_python",
      "tier": "extended",
      "probe": {
        "type": "python-module",
        "module": "matplotlib",
        "env": "PLOT_PY",
        "distribution": "matplotlib"
      },
      "purpose": "环形图绘制（run_circular_map.sh）",
      "install": "在 PLOT_PY 指向的环境里 pip install biopython matplotlib"
    },
    {
      "id": "network",
      "tier": "optional",
      "probe": {
        "type": "network",
        "host": "eutils.ncbi.nlm.nih.gov"
      },
      "purpose": "公共参考获取 / COX1 远程查询 / 公共同步",
      "install": "无需安装；受限网络下这些步骤不可用，其余步骤不受影响"
    },
    {
      "id": "table2asn",
      "tier": "optional",
      "probe": {
        "type": "command",
        "name": "table2asn"
      },
      "purpose": "NCBI 提交预检（不在本 skill 自检范围内）",
      "install": "见 NCBI 官方页面（人工执行）"
    },
    {
      "id": "getorganelle",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "get_organelle_from_reads.py"
      },
      "purpose": "Illumina paired-end/single-end reads 的线粒体候选组装（animal_mt）；具体可用性仍取决于样本、读段和组装图",
      "install": "按上游安装说明安装 GetOrganelle，并初始化 animal_mt 数据库：https://github.com/Kinggerm/GetOrganelle"
    },
    {
      "id": "mitoz",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "mitoz"
      },
      "purpose": "动物线粒体 reads 组装、候选筛选和注释；需核查类群与密码表设置",
      "install": "conda install -c bioconda mitoz"
    },
    {
      "id": "mitoflex",
      "tier": "extended",
      "probe": {
        "type": "command",
        "name": "MitoFlex.py",
        "env": "MITOFLEX_ROOT"
      },
      "purpose": "动物线粒体 Illumina reads 组装与注释候选；需要其独立 conda 环境",
      "install": "按上游环境文件安装：https://github.com/Prunoideae/MitoFlex"
    },
    {
      "id": "novoplasty",
      "tier": "extended",
      "probe": {
        "type": "file",
        "name": "NOVOPlasty4.3.5.pl",
        "env": "NOVOPLASTY"
      },
      "purpose": "seed-and-extend 线粒体候选组装；必须记录种子来源",
      "install": "按上游说明部署 Perl 脚本：https://github.com/ndierckx/NOVOPlasty"
    }
  ],
  "stages": {
    "assembly_intake": {
      "tier": "essential",
      "requires": [
        "python3"
      ],
      "tools": "scripts/assembly_intake.py",
      "capability": "FASTA 只读入口盘点（记录、长度、模糊碱基、SHA-256）"
    },
    "seq_stats": {
      "tier": "essential",
      "requires": [
        "python3",
        "biopython"
      ],
      "tools": "scripts/seq_stats.py",
      "capability": "序列体检（长度/GC/模糊碱基）"
    },
    "annot_check": {
      "tier": "essential",
      "requires": [
        "python3",
        "biopython"
      ],
      "tools": "scripts/annot_check.py",
      "capability": "注释一致性质检"
    },
    "annot_independent": {
      "tier": "extended",
      "requires": [
        "python3",
        "biopython",
        "mitos2",
        "mitos2_refdir",
        "cmsearch",
        "mitos2_reshape2"
      ],
      "tools": "scripts/run_mitos2.sh + scripts/mitos2_to_genbank.py",
      "capability": "独立重新注释（第二意见）"
    },
    "gene_locating": {
      "tier": "essential",
      "requires": [
        "python3",
        "biopython",
        "blastn",
        "makeblastdb"
      ],
      "tools": "scripts/blast_genes.py",
      "capability": "参考基因定位与顺序对照"
    },
    "read_evidence": {
      "tier": "essential",
      "requires": [
        "samtools"
      ],
      "tools": "scripts/depth_analysis.py",
      "capability": "reads 覆盖/深度/碱基支持"
    },
    "circularize": {
      "tier": "essential",
      "requires": [
        "python3",
        "biopython",
        "blastn",
        "minimap2",
        "samtools"
      ],
      "tools": "scripts/circularize.py",
      "capability": "接缝/环化候选的证据链"
    },
    "reference_acquisition": {
      "tier": "optional",
      "requires": [
        "network"
      ],
      "tools": "scripts/reference_registry.py",
      "capability": "获取公共参考（不上传样本）"
    },
    "cox1_identity": {
      "tier": "optional",
      "requires": [
        "network"
      ],
      "tools": "scripts/cox1_id.py",
      "capability": "COX1 远程查询（会上传片段，须显式授权）"
    },
    "circular_plot": {
      "tier": "extended",
      "requires": [
        "plot_python"
      ],
      "tools": "scripts/run_circular_map.sh",
      "capability": "论文级环形图"
    },
    "read_alignment": {
      "tier": "essential",
      "requires": [
        "minimap2"
      ],
      "tools": "(外部命令：minimap2/bwa)",
      "capability": "reads 回贴生成 BAM（后续证据的前提）"
    },
    "mitos2_bridge": {
      "tier": "essential",
      "requires": [
        "python3",
        "biopython"
      ],
      "tools": "scripts/mitos2_to_genbank.py",
      "capability": "MITOS2 输出转 GenBank（annot_check 的输入）"
    },
    "case_records": {
      "tier": "essential",
      "requires": [
        "python3",
        "jsonschema"
      ],
      "tools": "scripts/case.py",
      "capability": "任务内输入、事件、逐条结论、校验与报告（不启用跨任务学习）"
    },
    "apply_candidate": {
      "tier": "essential",
      "requires": [
        "python3",
        "biopython"
      ],
      "tools": "scripts/apply_candidate.py",
      "capability": "按显式 edits 清单生成碱基替换或 CDS 边界候选，并保存差异清单；不做科学验收"
    },
    "assembly_from_illumina_reads": {
      "tier": "extended",
      "requires": [
        "getorganelle"
      ],
      "tools": "外部命令 get_organelle_from_reads.py -F animal_mt",
      "capability": "Illumina animal mitochondrial assembly candidate generation; graph and junctions require independent review"
    },
    "assembly_compare_illumina": {
      "tier": "extended",
      "requires": [
        "python3",
        "getorganelle",
        "mitoz"
      ],
      "tools": "scripts/run_illumina_candidates.py",
      "capability": "至少具备 GetOrganelle 与 MitoZ 两条独立动物线粒体 Illumina 候选路线；MitoFlex/NOVOPlasty/MitoFinder 可按环境及输入条件加入；登记候选、状态、版本、命令与日志"
    },
    "annotate_compare": {
      "tier": "extended",
      "requires": [
        "python3",
        "mitos2",
        "mitos2_refdir",
        "cmsearch",
        "mitoz"
      ],
      "tools": "scripts/run_candidate_annotations.py",
      "capability": "对每个组装候选运行 MITOS2 与 MitoZ 注释候选；结果需逐基因证据裁决，不按工具投票"
    },
    "background_tasks": {
      "tier": "essential",
      "requires": [
        "python3"
      ],
      "tools": "scripts/task_manager.py",
      "capability": "将长时间命令脱离交互会话运行，并在样本 intermediate/tasks 中记录命令、日志、状态与退出码"
    }
  }
}
