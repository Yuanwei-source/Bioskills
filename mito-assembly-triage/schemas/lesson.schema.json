{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mito-assembly-triage local lesson revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lesson_id",
    "revision",
    "validation_status",
    "lesson_domain",
    "source_case_type",
    "title",
    "claim",
    "diagnostic_clues",
    "suggested_next_test",
    "applicable_when",
    "not_applicable_when",
    "supporting_case_ids",
    "counterexample_case_ids",
    "sources",
    "conflicts",
    "generalization_scope",
    "transferability",
    "review_history",
    "created_at",
    "updated_at",
    "last_reviewed",
    "supersedes",
    "content_hash"
  ],
  "properties": {
    "lesson_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "validation_status": {"enum": ["candidate", "verified", "rejected", "deprecated", "withdrawn", "superseded"]},
    "lesson_domain": {"enum": ["tool", "annotation", "biology"]},
    "source_case_type": {"enum": ["abnormal_case", "normal_validation_case", "tool_failure_case"]},
    "title": {"$ref": "#/$defs/text"},
    "claim": {"$ref": "#/$defs/text"},
    "diagnostic_clues": {"$ref": "#/$defs/nonemptyStrings"},
    "suggested_next_test": {"$ref": "#/$defs/text"},
    "applicable_when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxa", "data_types", "conditions"],
      "properties": {
        "taxa": {"$ref": "#/$defs/nonemptyStrings"},
        "data_types": {"$ref": "#/$defs/nonemptyStrings"},
        "conditions": {"$ref": "#/$defs/strings"}
      }
    },
    "not_applicable_when": {"$ref": "#/$defs/strings"},
    "supporting_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "counterexample_case_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "path", "case_sha256"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "pattern": "^/"},
          "case_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "generalization_scope": {"enum": ["single_case", "species", "genus", "family", "order", "multi_taxon"]},
    "transferability": {"enum": ["none", "low", "moderate", "high"]},
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_status", "to_status", "reviewer", "reason", "reviewed_at"],
        "properties": {
          "from_status": {"enum": ["candidate", "verified", "rejected", "deprecated", "withdrawn", "superseded"]},
          "to_status": {"enum": ["candidate", "verified", "rejected", "deprecated", "withdrawn", "superseded"]},
          "reviewer": {"$ref": "#/$defs/text"},
          "reason": {"$ref": "#/$defs/text"},
          "reviewed_at": {"$ref": "#/$defs/text"}
        }
      }
    },
    "created_at": {"$ref": "#/$defs/text"},
    "updated_at": {"$ref": "#/$defs/text"},
    "last_reviewed": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "supersedes": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lesson_id", "revision"],
          "properties": {
            "lesson_id": {"$ref": "#/$defs/id"},
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    }
  }
}
