{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mito-assembly-triage:taxon-profiles:1",
  "title": "Mitochondrial taxon profiles",
  "type": "object",
  "required": ["format", "profiles"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "mito-taxon-profiles-1"},
    "profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["claim", "url", "scope"],
      "additionalProperties": false,
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "required": ["scientific_name", "lineage", "mitochondrial_code", "engineering_thresholds"],
      "additionalProperties": false,
      "properties": {
        "scientific_name": {"type": "string", "minLength": 1},
        "ncbi_taxon_id": {"type": "integer", "minimum": 1},
        "lineage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mitochondrial_code": {
          "type": "object",
          "required": ["table", "status", "species_specific_confirmed", "auto_select", "evidence", "limitations"],
          "additionalProperties": false,
          "properties": {
            "table": {"type": "integer", "minimum": 1},
            "status": {"enum": ["provisional", "validated"]},
            "species_specific_confirmed": {"type": "boolean"},
            "auto_select": {"const": false},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
            "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "engineering_thresholds": {
          "type": "array",
          "items": {"type": "object", "required": ["name", "status", "value", "source"], "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["validated", "provisional"]},
              "value": {},
              "source": {"$ref": "#/$defs/source"}
            }
          }
        }
      }
    }
  }
}
