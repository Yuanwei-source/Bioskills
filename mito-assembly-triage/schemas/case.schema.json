{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mito-assembly-triage V2 case",
  "type": "object",
  "required": ["schema_version", "case_id", "inputs", "issue", "hypotheses", "decision", "events_file"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "case_id": {"type": "string", "minLength": 1},
    "case_type": {"enum": ["abnormal_case", "normal_validation_case", "tool_failure_case"]},
    "taxon": {"type": "object"},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["role", "path", "sha256"]}},
    "issue": {"type": "object", "required": ["type"]},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "explanation", "support", "against", "unknown"]}},
    "events_file": {"type": "string"},
    "decision": {"type": "object", "required": ["status", "confidence", "rationale"], "properties": {"status": {"enum": ["RESOLVED", "NO_CHANGE", "UNRESOLVED"]}, "confidence": {"enum": ["high", "moderate", "low", "not_assessable"]}}},
    "anomalies": {"type": "array", "items": {"type": "object", "required": ["id", "claim", "status", "confidence"], "properties": {"status": {"enum": ["RESOLVED", "NO_CHANGE", "UNRESOLVED"]}, "confidence": {"enum": ["high", "moderate", "low", "not_assessable"]}, "reads_support": {"enum": ["NOT_ASSESSED", "READS_CONSISTENT", "READS_DISCRIMINATING"]}}}},
    "references": {"type": "array", "items": {"type": "object", "required": ["reference_id", "accession", "purpose"]}},
    "modifications": {"type": "array"},
    "validation": {"type": "array"},
    "lessons_proposed": {"type": "array"}
  }
}
