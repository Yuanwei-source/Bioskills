{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task evidence ledger v3 (format is not scientific validation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "issue",
    "taxon",
    "created_at",
    "updated_at",
    "revision",
    "inputs",
    "events",
    "conclusions",
    "conclusion_history"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "case_type": {
      "enum": [
        "abnormal_case",
        "normal_validation_case",
        "tool_failure_case"
      ]
    },
    "issue": {
      "$ref": "#/$defs/text"
    },
    "taxon": {
      "$ref": "#/$defs/text"
    },
    "created_at": {
      "$ref": "#/$defs/text"
    },
    "updated_at": {
      "$ref": "#/$defs/text"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "conclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conclusion"
      }
    },
    "conclusion_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "replaced_at",
          "revision",
          "conclusion"
        ],
        "properties": {
          "replaced_at": {
            "$ref": "#/$defs/text"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "conclusion": {
            "$ref": "#/$defs/conclusion"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recorded_at",
        "action",
        "command",
        "working_directory",
        "tool_version",
        "exit_code",
        "execution_status",
        "input_ids",
        "summary",
        "artifacts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "recorded_at": {
          "$ref": "#/$defs/text"
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string",
          "pattern": "^/"
        },
        "tool_version": {
          "$ref": "#/$defs/text"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "execution_status": {
          "enum": [
            "completed",
            "failed",
            "not_run"
          ]
        },
        "input_ids": {
          "$ref": "#/$defs/ids"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "artifact_id",
        "observation"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "observation": {
          "$ref": "#/$defs/text"
        },
        "coordinates": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recorded_at",
        "claim",
        "conclusion_type",
        "status",
        "confidence",
        "reads_support",
        "evidence_for",
        "evidence_against",
        "not_tested",
        "scope",
        "limitations",
        "rationale",
        "next_steps",
        "decided_by",
        "review",
        "competitive_reference_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "recorded_at": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "$ref": "#/$defs/text"
        },
        "conclusion_type": {
          "enum": [
            "assembly_quality",
            "annotation_quality",
            "gene_identity",
            "sequence_accuracy",
            "biological_interpretation",
            "tool_execution"
          ]
        },
        "status": {
          "enum": [
            "RESOLVED",
            "NO_CHANGE",
            "UNRESOLVED"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "moderate",
            "low",
            "not_assessable"
          ]
        },
        "reads_support": {
          "enum": [
            "NOT_ASSESSED",
            "READS_CONSISTENT",
            "READS_DISCRIMINATING"
          ]
        },
        "evidence_for": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_against": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "not_tested": {
          "$ref": "#/$defs/strings"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "next_steps": {
          "$ref": "#/$defs/strings"
        },
        "decided_by": {
          "$ref": "#/$defs/text"
        },
        "competitive_reference_ids": {
          "$ref": "#/$defs/ids"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "status",
            "reviewer",
            "note"
          ],
          "properties": {
            "level": {
              "enum": [
                "AUTO",
                "ASSIST",
                "EXPERT"
              ]
            },
            "status": {
              "enum": [
                "not_requested",
                "pending",
                "reviewed",
                "disputed"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ]
            },
            "note": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "candidate_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "result",
        "criteria",
        "notes",
        "recorded_at"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "criteria": {
          "$ref": "#/$defs/text"
        },
        "notes": {
          "$ref": "#/$defs/text"
        },
        "recorded_at": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change_type",
        "base_input_id",
        "candidate_input_id",
        "producer_event_id",
        "artifact_id",
        "rationale",
        "expected_effect",
        "risks",
        "created_at",
        "checks",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "change_type": {
          "enum": [
            "annotation",
            "sequence",
            "structure"
          ]
        },
        "base_input_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_input_id": {
          "$ref": "#/$defs/id"
        },
        "producer_event_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "expected_effect": {
          "$ref": "#/$defs/text"
        },
        "risks": {
          "$ref": "#/$defs/strings"
        },
        "created_at": {
          "$ref": "#/$defs/text"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_check"
          }
        },
        "status": {
          "enum": [
            "proposed",
            "verified",
            "rejected",
            "inconclusive"
          ]
        }
      }
    }
  }
}
